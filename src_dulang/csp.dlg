mod csp_channel {
  $ spawn and register a channel proc
  pub fn create = (name) => register(name, spawn(fn () => main(#{@queue = #{}, @waiting = [], @relations = [], @sync_msgs = #{}, @name = name})))
  $ @queue: data async sent to this proc
  $ @waiting: procs waiting to data from this proc, those procs are not in any relation
  $ @relations: list of tuples: a set with the pids that are synchronizing in this channel and the counter of how many are already waiting
  $ @sync_msgs: the msgs that every waiting sync proc sent: can be @event, @recv, {@sent, data}
  fn main = (ctx <- #{@queue: queue, @waiting: waiting, @relations: relations, @sync_msgs: sync_msgs, @name: name}) =>
      ?({@rel, {{parent, some, other},0}}) {
        s = sets:from_list([some,other]);
        match lists:partition(fn({set, cnt}) => sets:is_element(parent, set), relations)
        | ({[], not_related}) => main(ctx#{@relations = {s,0} :: not_related})
        | ({from_parent, not_related}) => main(ctx#{@relations = lists:concat(
            lists:map(fn({set, cnt}) => sets:union(s,sets:del_element(parent, set)), from_parent), not_related
          )})
      }
      |(@debug) { _=utils:print(ctx); main(ctx) }
      |({content, from}) =>
        main(match {has_relation(from, relations), content}
          | ({false, {@event, ps}}) { _ = from ! {cast(), {name, ps}}; ctx }
          | ({false, {@intent, ps, intentions}}) => (
            match (lists:filter(fn({other,intent_,ps_}) => intentions == csp_utils:opposed(intent_), waiting))
            | ([]) => ctx#{@waiting = {from, intentions, ps} :: waiting}
            | ({other,intent_,ps_} :: tl) {
              _= from ! {cast(), {@intent, name, ps}};
              _= other ! {cast(), {@intent, name, ps_}};
              set = sets:from_list([from, other]);
              ctx#{@waiting = tl, @queue = queue#{set = {@empty, @none, length(intentions)}}}
            })
          | ({false, {@recv, ps}}) {
            {set, value} = hd(lists:filter(fn({s,_}) => sets:is_element(from, s), maps:to_list(queue)));
            match value
              | ({@empty, @none, cnt}) => ctx#{@queue = queue#{set = {@waiting, ps, cnt}}}
              | ({data, ps_, cnt}) {
                _ = from ! {cast(),{name, ps, data}};
                other = hd(sets:to_list(sets:del_element(from, set)));
                _= other ! {cast(),{name, ps_}};
                match cnt
                | (1) => ctx#{@queue = sets:del_element(set, queue)}
                | (x) => ctx#{@queue = queue#{set = {@empty, @none, x - 1}}}
              }
          }
          | ({false, {@send, ps, data}}) {
            {set, value} = hd(lists:filter(fn({s,_}) => sets:is_element(from, s), maps:to_list(queue)));
            match value
              | ({@empty, @none, cnt}) => ctx#{@queue = queue#{set = {data, ps, cnt}}}
              | ({@waiting, ps_, cnt}) {
                _ = from ! {cast(),{name, ps}};
                other = hd(sets:to_list(sets:del_element(from, set)));
                _= other ! {cast(),{name, ps_, data}};
                match cnt
                | (1) => ctx#{@queue = sets:del_element(set, queue) }
                | (x) => ctx#{@queue = queue#{set = {@empty, @none, x - 1}}}
              }
          }
          | ({{@value, elem <- {set, cnt}}, c}) =>
            (match (sets:size(set) == (cnt+1))
            | (true) {
              @ok = dispatch_sync_msgs(sync_msgs#{from = c}, set, name);
              ctx#{@relations = {set, 0} :: lists:delete(elem, relations)}
            }
            | (false) => ctx#{
                @relations = {set, cnt+1} :: lists:delete(elem, relations),
                @sync_msgs = sync_msgs#{from = c}
            }
            )
          | (something) => error(something)
        )
  fn has_relation = (pid, relations) => lists:search(fn({set, _}) => sets:is_element(pid, set), relations)
  fn dispatch_sync_msgs = (msgs, set, name) {
    $ Turn the stored messages from every member of the set into a list
    l = lists:filter(fn({x, _}) => sets:is_element(x, set), maps:to_list(msgs));
    $ Sort the list to handle @send first, to accumulate data that will be sent to the ones that want to receive it
    sorted = lists:sort(fn({_, {@send, _}}, _) => true | (_, {_, {@send, _}}) => false | (_, _) => true, l);
    _=lists:foldl(
      fn({from, {@send, ps, x}}, acc) {
        _=from ! {name, ps};
        x :: acc
      }|({from, {@recv, ps}}, x :: tl) {
        _=from ! {name, ps, x};
        tl
      }
      $ This branch handles a recv that has no data to receive
      |({from, {@recv, ps}}, []) => error(@not_implemented)
      |({from, {@event, ps}}, acc) {
        _=from ! {cast(),{name, ps}};
        acc
      }, [], sorted);
    @ok
  }
  fn cast = () => list_to_atom("$gen_cast")
  pub fn event = (name, ps, return) {
    _= name ! {{@event, ps}, self()};
    return
  }
  pub fn intent = (name, ps, intentions, return) {
    _= name ! {{@intent, ps, intentions}, self()};
    return
  }
  pub fn send = (name, ps, sending, return) {
    _= name ! {{@send, ps, sending}, self()};
    return
  }
  pub fn recv = (name, ps, return) {
    _= name ! {{@recv, ps}, self()};
    return
  }
  $ Receives a list of channels and two PIDs that will sync on them
  $   self() is the parent of 'some' and 'other' pids,
  $   both needing to inherit all relations from its parent
  pub fn sync = (channels, some, other) =>
    lists:foreach(fn(c) => c ! {@rel, {{self(), some, other}, 0}}, channels)
}

mod csp_utils {
  $ Used to add an event to some state queue, so it can handle it later
  $ this can happen when the state handles external choice
  pub fn add_to_state_queue = (state, msg, data <- #{@queue: q}) {
      q_new = match maps:is_key(state, q)
      | (true) => maps:update(state, msg :: maps:get(state, q), q)
      | (false) => q#{state = [msg]};
      data#{@queue = q_new}
  }
  pub fn opposed = (values) =>
    lists:map(fn(val) =>
        match val
        | (@out) => @in
        | (@in) => @out
        | (any) => any, values)
}

mod csp_channel {
  $ spawn and register a channel proc
  pub fn create = (name) => register(name, spawn(fn () => main(#{@queue = #{}, @waiting = [], @relations = [], @sync_waiting = #{}, @name = name, @seed = 0})))
  fn main = (ctx <- #{@queue: queue, @waiting: waiting, @relations: relations, @sync_waiting: sync_waiting, @name: name, @seed: seed}) =>
      $ when a new relation comes two new ids are created, inheriting the parent relations from its id
      ?(@debug) { _=utils:print(ctx); main(ctx) }
      |({@rel, {from, parent_id}}) {
        {l_id, r_id, new_seed} = {seed, seed+1, seed+2};
        _= from ! {@rel_response, {l_id,r_id}}; $ response with the new ids
        s = sets:from_list([l_id,r_id]);
        match lists:partition(fn(set) => sets:is_element(parent_id, set), relations)
        | ({[], not_related}) => main(ctx#{@relations = s :: not_related, @seed = new_seed, @sync_waiting = sync_waiting#{l_id = [], r_id = []}})
        | ({from_parent, not_related}) {
          inherited = lists:map(fn(set) => sets:union(s,sets:del_element(parent_id, set)), from_parent);
          main(ctx#{@relations = lists:concat([ inherited, from_parent, not_related ]), @seed = new_seed, @sync_waiting = sync_waiting#{l_id = [], r_id = []}})
        }
      }
      |({{@intent, ps, intentions}, {from, id}}) =>
        main(match has_relation(id, relations)
        |([]) =>
          (match intentions
          |([]) { $ Events have an empty intention
            _= from ! {cast(), {@intent, name, ps}};
            ctx
          }
          |(_) => (match (lists:search(fn({other,intent_,ps_}) => intentions == csp_utils:opposed(intent_), waiting))
            | (false) => ctx#{@waiting = {from, intentions, ps} :: waiting}
            | ({@value, (elem <- {other,intent_,ps_})}) {  $ here i need to check if more than one intention matches
              _= from ! {cast(), {@intent, name, ps}};
              _= other ! {cast(), {@intent, name, ps_}};
              set = sets:from_list([from, other]);
              ctx#{@waiting = lists:delete(elem, waiting), @queue = queue#{set = {@empty, @none, length(intentions)}}}
            }))
        |(cur_relations) {
          sw = sync_waiting#{id = {from, intentions, ps}::maps:get(id,sync_waiting)};
          possible_relations =
            lists:sort(fn(a, b) => sets:size(a) > sets:size(b),
              lists:filter(fn(rel) =>
                lists:all(fn(id_) => length(maps:get(id_,sw)) > 0, sets:to_list(rel)),
              cur_relations));
          sw_list = lists:concat(lists:map(fn({id_, l}) => lists:map(fn({x, y, z}) => {id_, x, y, z}, l), maps:to_list(sw)));
          (match possible_relations
          |(_) {
            fn test_choosen = ((e <- {_,from,i,ps}) :: tl, acc) =>
              (match {csp_utils:has_comm(i), lists:filter(fn({_,_,intention,_}) => i == csp_utils:opposed(intention), tl)}
              |({true, h :: _}) => test_choosen(lists:delete(h,tl), {@comm,e,h} :: acc)
              |({true, []}) => false
              |({false, []}) => false
              |({false, l}) => test_choosen(lists:subtract(tl,l), {@sync, e :: l} :: acc))
            |([], acc) {
              _=lists:foreach(
                (fn({@comm,{_,some,_,ps},{_,other,_,ps_other}}) {
                  _= some ! {cast(), {@intent, name, ps}};
                  _= other ! {cast(), {@intent, name, ps_other}};
                  @ok
                }
                |({@sync, l}) => lists:foreach(fn({_,some,_,ps}) => some ! {cast(), {@intent, name, ps}}, l)) ,acc);
              acc
            };
            fn it = (id :: rest, acc, valids) {
              {to_test,still_valids} = lists:partition(fn({id_,_,_,_}) => id_ == id, valids);
              csp_utils:until_find(fn(e) => it(rest, e :: acc, still_valids), to_test)
            }
            |([],acc,_) =>
              (match test_choosen(acc, [])
              |(false) => false
              |(v) => v);
            match csp_utils:until_find(fn(rel) => it(sets:to_list(rel),[],sw_list), csp_utils:shuffle(possible_relations))
            |(false) => ctx#{@sync_waiting = sw}
            |(v) =>
              lists:foldl(
                (fn({@sync, l}, c <- #{@sync_waiting: sw_}) {
                  w_ = lists:foldl(fn({id_, f, i, p}, w) => w#{id_ = lists:delete({f,i,p},maps:get(id_,w))}, sw_, l);
                  ctx#{@sync_waiting = w_}
                }
                |({@comm, {id1,f1,i1,p1}, {id2,f2,i2,p2}}, c <- #{@sync_waiting: w, @queue: q}) {
                  set = sets:from_list([f1,f2]);
                  c#{ @queue = q#{ set = {@empty,@none,length(i1)} },
                  @sync_waiting = w#{id1 = lists:delete({f1,i1,p1},maps:get(id1,w)), id2 = lists:delete({f2,i2,p2},maps:get(id2,w))}}
                })
              , ctx#{@sync_waiting = sw}, v)
          }
          |([]) => ctx#{@sync_waiting = sw})
        })
      |({{@recv, ps}, from}) {
        {@value, {set, value}} = lists:search(fn({s,_}) => sets:is_element(from, s), maps:to_list(queue));
        main(match value
          | ({@empty, @none, cnt}) => ctx#{@queue = queue#{set = {@waiting, ps, cnt}}}
          | ({data, ps_, cnt}) {
            _ = from ! {cast(),{name, ps, data}};
            other = hd(sets:to_list(sets:del_element(from, set)));
            _= other ! {cast(),{name, ps_}};
            match cnt
            | (1) => ctx#{@queue = sets:del_element(set, queue)}
            | (x) => ctx#{@queue = queue#{set = {@empty, @none, x - 1}}}
          })
      }
      |({{@send, ps, data}, from}) {
        {@value, {set, value}} = lists:search(fn({s,_}) => sets:is_element(from, s), maps:to_list(queue));
        main(match value
          | ({@empty, @none, cnt}) => ctx#{@queue = queue#{set = {data, ps, cnt}}}
          | ({@waiting, ps_, cnt}) {
            _ = from ! {cast(),{name, ps}};
            other = hd(sets:to_list(sets:del_element(from, set)));
            _= other ! {cast(),{name, ps_, data}};
            match cnt
            | (1) => ctx#{@queue = sets:del_element(set, queue) }
            | (x) => ctx#{@queue = queue#{set = {@empty, @none, x - 1}}}
          })
      }
      | (something) => error(something)
  fn has_relation = (id, relations) =>
    lists:filter(fn(set) => sets:is_element(id, set), relations)
  fn cast = () => list_to_atom("$gen_cast")
  pub fn intent = (name, ps, ns, intentions, data) {
    _= name ! {{@intent, ps, intentions}, {self(), csp_utils:try_get_id(name, data)}};
    {@next_state, ns, data}
  }
  pub fn send = (name, ps, ns, sending, data) {
    _= name ! {{@send, ps, sending}, self()};
    {@next_state, ns, data}
  }
  pub fn recv = (name, ps, ns, data) {
    _= name ! {{@recv, ps}, self()};
    {@next_state, ns, data}
  }
  $ Receives a list of channels and the ids map
  $ ids map will contain the id from each channel that represents the process
  pub fn sync = (channels, data <- #{@ids:ids}) {
    {l_ids,r_ids} = lists:foldl(fn(c,{l_ids,r_ids}) {
      $ sends the pid and the parent id, if exists
      _= c ! {@rel, {self(), csp_utils:try_get_id(c, data)}};
      ?({@rel_response, {l_id,r_id}}) => {l_ids#{c = l_id}, r_ids#{c = r_id}}
    }, {ids,ids}, channels);
    {data#{@ids=l_ids},data#{@ids=r_ids}}
  }
}

mod csp_utils {
  $ Used to add an event to some state queue, so it can handle it later
  $ this can happen when the state handles external choice
  pub fn add_to_state_queue = (state, msg, data <- #{@queue: q}) {
      q_new = match maps:is_key(state, q)
      | (true) => maps:update(state, msg :: maps:get(state, q), q)
      | (false) => q#{state = [msg]};
      data#{@queue = q_new}
  }
  pub fn opposed = (values) =>
    lists:map(fn(val) =>
        match val
        | (@out) => @in
        | (@in) => @out
        | (any) => any, values)
  pub fn try_get_id = (channel_name, #{@ids : ids}) =>
    (match maps:is_key(channel_name, ids)
    |(false) => @none
    |(true) => maps:get(channel_name, ids))
    |(_,_) => @none
  pub fn has_comm = (l) =>
    lists:any(fn(v) => ((v == @out) or (v == @in)), l)
  pub fn until_find =
   (_, []) => false
  |(f, x :: tl) =>
    (match f(x)
        |(false) => until_find(f, tl)
        |(value) => value)
  pub fn shuffle = (list) {
    withKeys = lists:map(fn(x) => {rand:uniform(), x}, list);
    sorted = lists:sort(withKeys);
    lists:map(fn({_, x}) => x, sorted)
  }
}

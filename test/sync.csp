channel a, b
channel w, x, y, z
channel c: {1..10}

Q = c?1 -> a -> b -> Q
	[]
    b -> a -> STOP
P = c!1 -> a -> b -> Q
R = c?X -> c!X -> STOP

SYN_QP = Q [| {|a, b|} |] P
SYN_RP = P [| {|c|} |] R

X = w -> x -> STOP
Y = y -> z -> STOP
Z = w -> x -> Z
	[]
    y -> z -> Z

SYN_XZ  = X [| {|w, x, y, z|} |] Z
SYN_XZY = SYN_XZ [| {|w, x, y, z|} |] Y
